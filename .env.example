# ===== Aplicación =====
APP_NAME=Serial Manager
APP_ENV=development            # development | production
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Base de datos =====
# Producción / docker-compose (MySQL 8):
DATABASE_URL=mysql+pymysql://serial:serial@db:3306/serial_manager
# Smoke-test local sin MySQL (descomenta para usar SQLite):
# DATABASE_URL=sqlite:///./serial_manager.db

# ===== Autenticación / JWT =====
AUTH_PROVIDER=local            # local | oidc | ldap | external_api
JWT_SECRET=cambia-esto-en-produccion
JWT_ALG=HS256
JWT_EXPIRES_MIN=60
JWT_REFRESH_EXPIRES_MIN=10080  # 7 días

# ===== Usuario admin inicial (seed, solo modo local) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=Administrador

# ===== OIDC (modo cliente con su IdP) =====
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=realm_access.roles

# ===== LDAP / Active Directory =====
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_TEMPLATE=
LDAP_ADMIN_GROUP=

# ===== API externa de usuarios del cliente =====
EXTAUTH_VALIDATE_URL=
EXTAUTH_API_KEY=
EXTAUTH_ROLE_FIELD=role
